{
  "name": "@kineojs/monorepo",
  "private": true,
  "scripts": {
    "test": "vitest",
    "dev": "turbo run dev",
    "serve": "turbo run serve",
    "check": "turbo run check",
    "build:pkg": "turbo run prepare",
    "build:app": "turbo run build",
    "build:all": "turbo run prepare build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
