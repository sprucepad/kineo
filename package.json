{
  "name": "@kineojs/monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "vitest",
    "dev": "turbo run dev",
    "serve": "turbo run serve",
