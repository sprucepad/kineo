    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "knip": "^6.7.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
