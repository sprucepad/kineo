{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    "packages/*": {
      "entry": ["src/index.ts", "*.config.{js,ts}"],
      "project": ["src/**/*.{js,ts,tsx}"]
    },
    "examples/*": {
      "entry": ["src/{index,main}.ts", "*.config.{js,ts}"],
      "project": ["src/**/*.{js,jsx,ts,tsx}"]
    }
  }
}
