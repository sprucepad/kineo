{
  "name": "kineo",
  "type": "module",
  "version": "0.12.0",
  "description": "Declarative, TypeScript-first Object-Relation Mapper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprucepad/kineo"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "bin": {
    "kineo": "./dist/main.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "import": "./dist/schema/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs"
    },
    "./ir": {
      "types": "./dist/ir/index.d.mts",
      "import": "./dist/ir/index.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.mts",
      "import": "./dist/adapter/index.mjs"
    },
    "./adapter/postgres": {
      "types": "./dist/adapter/postgres/index.d.mts",
      "import": "./dist/adapter/postgres/index.mjs"
    },
    "./adapter/postgres/runtime": {
      "types": "./dist/adapter/postgres/runtime.d.mts",
      "import": "./dist/adapter/postgres/runtime.mjs"
    },
    "./adapter/sqlite3": {
      "types": "./dist/adapter/sqlite3/index.d.mts",
      "import": "./dist/adapter/sqlite3/index.mjs"
    },
    "./adapter/sqlite3/runtime": {
      "types": "./dist/adapter/sqlite3/runtime.d.mts",
      "import": "./dist/adapter/sqlite3/runtime.mjs"
    },
    "./adapter/libsql": {
      "types": "./dist/adapter/libsql/index.d.mts",
      "import": "./dist/adapter/libsql/index.mjs"
    },
    "./adapter/libsql/runtime": {
      "types": "./dist/adapter/libsql/runtime.d.mts",
      "import": "./dist/adapter/libsql/runtime.mjs"
    },
    "./adapter/mysql2": {
      "types": "./dist/adapter/mysql2/index.d.mts",
      "import": "./dist/adapter/mysql2/index.mjs"
    },
    "./adapter/mysql2/runtime": {
      "types": "./dist/adapter/mysql2/runtime.d.mts",
      "import": "./dist/adapter/mysql2/runtime.mjs"
    },
    "./adapter/mssql": {
      "types": "./dist/adapter/mssql/index.d.mts",
      "import": "./dist/adapter/mssql/index.mjs"
    },
    "./adapter/mssql/runtime": {
      "types": "./dist/adapter/mssql/runtime.d.mts",
      "import": "./dist/adapter/mssql/runtime.mjs"
    },
    "./emitter/sql": {
      "types": "./dist/emitter/sql/index.d.mts",
      "import": "./dist/emitter/sql/index.mjs"
    },
    "./migration/sql": {
      "types": "./dist/migration/sql/index.d.mts",
      "import": "./dist/migration/sql/index.mjs"
    }
  },
  "scripts": {
    "prepare": "tsdown",
    "lint": "eslint",
    "check": "tsc"
  },
  "keywords": [
    "orm",
    "object-relation-mapper"
  ],
  "files": [
    "src",
    "dist"
  ],
  "author": "sprucepad",
  "license": "MIT",
  "dependencies": {
    "convoker": "^0.5.3",
    "decimal.js": "^10.6.0",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.10.0",
    "mysql2": "^3.22.3",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dev/configs": "workspace:*",
    "@testcontainers/mysql": "^11.14.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.15.22",
    "better-sqlite3": "^12.10.0",
    "eslint": "^10.3.0",
    "mysql2": "^3.22.3",
    "postgres": "^3.4.9",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
