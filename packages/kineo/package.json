{
  "name": "kineo",
  "version": "0.10.0",
  "type": "module",
  "description": "Declarive, TypeScript-first Object-Relation/Graph Mapper (ORM/OGM).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprucepad/kineo"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./error": {
      "types": "./dist/error.d.mts",
      "import": "./dist/error.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs"
    },
    "./model": {
      "types": "./dist/model.d.mts",
      "import": "./dist/model.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.mts",
      "import": "./dist/adapter.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./ir": {
      "types": "./dist/ir.d.mts",
      "import": "./dist/import.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./adapter/neo4j": {
      "types": "./dist/adapters/neo4j.d.mts",
      "import": "./dist/adapters/neo4j.mjs"
    },
    "./compiler/cypher": {
      "types": "./dist/compilers/cypher.d.mts",
      "import": "./dist/compilers/cypher.mjs"
    },
    "./compiler/sql": {
      "types": "./dist/compilers/sql.d.mts",
      "import": "./dist/compilers/sql.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc",
    "build": "tsdown",
    "test": "vitest",
    "prepare": "pnpm build"
  },
  "keywords": [
    "ogm",
    "orm",
    "object-graph-mapper",
    "object-relation-mapper"
  ],
  "author": "sprucepad",
  "license": "MIT",
  "optionalDependencies": {
    "neo4j-driver": "^6.0.0"
  }
}
