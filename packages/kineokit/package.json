{
  "name": "kineokit",
  "type": "module",
  "version": "0.2.2",
  "description": "Migration manager for Kineo.",
  "bin": {
    "kineokit": "./dist/main.mjs",
    "kineo": "./dist/main.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.mts",
      "import": "./dist/adapter.mjs"
    },
    "./adapters/neo4j": {
      "types": "./dist/adapters/neo4j.d.mts",
      "import": "./dist/adapters/neo4j.mjs"
    }
  },
  "scripts": {
    "kit": "jiti src/main.ts",
    "check": "tsc",
    "test": "vitest",
    "prepare": "tsdown"
  },
  "keywords": [
    "kineo",
    "migration",
    "kit"
  ],
  "author": "sprucepad",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "convoker": "^0.4.1",
    "jiti": "^2.6.1"
  },
  "peerDependencies": {
    "kineo": "workspace:*",
    "neo4j-driver": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "neo4j-driver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/neo4j": "^11.11.0",
    "kineo": "workspace:*",
    "neo4j-driver": "^6.0.0"
  }
}
