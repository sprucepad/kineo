{
  "name": "kineokit",
  "version": "0.1.1",
  "description": "Migration manager for Kineo.",
  "bin": {
    "kineokit": "./dist/main.mjs",
    "kineo": "./dist/main.mjs"
  },
  "exports": {
    "./adapters/neo4j": {
      "types": "./dist/neo4j.d.mts",
      "import": "./dist/neo4j.mjs"
    }
  },
  "scripts": {
    "kit": "jiti src/main.ts",
    "check": "tsc",
    "test": "vitest",
    "build": "tsdown"
  },
  "keywords": [
    "kineo",
    "migration",
    "kit"
  ],
  "author": "sprucepad",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "convoker": "^0.3.4",
    "jiti": "^2.6.1"
  },
  "peerDependencies": {
    "kineo": "workspace:*",
    "neo4j-driver": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "neo4j-driver": {
      "optional": true
    }
  },
  "devDependencies": {
    "kineo": "workspace:*"
  }
}
