{
  "name": "kineo",
  "version": "0.12.0-alpha",
  "description": "Experimental declarative TypeScript ORM",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprucepad/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.mts",
      "import": "./dist/adapter/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.mts",
      "import": "./dist/plugin/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "import": "./dist/schema/index.mjs"
    }
  },
  "bin": {
    "kineo": "./dist/main.mjs",
    "kineokit": "./dist/main.mjs"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "tsdown",
    "check": "tsc"
  },
  "keywords": [
    "experimental",
    "orm",
    "object-relation-mapper"
  ],
  "files": [
    "src",
    "dist"
  ],
  "author": "sprucepad",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@dev/configs": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@oxc-node/core": "^0.1.0",
    "convoker": "^0.6.2",
    "oxc-parser": "^0.142.0",
    "oxc-resolver": "^11.24.2",
    "oxc-transform": "^0.143.0",
    "oxc-walker": "^1.1.1"
  }
}
