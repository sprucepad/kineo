{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "tags": ["-lintignore"],
  "workspaces": {
    "packages/!(configs)": {
      "entry": ["src/{index,main}.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.{js,ts,tsx}", "tests/**/*.{js,ts,tsx}"],
      "ignore": [
        // Standard Schema
        "src/schema/standard.ts",
      ],
    },
    "examples/*": {
      "entry": ["src/{index,main}.ts"],
      "project": ["src/**/*.{js,jsx,ts,tsx}"],
    },
  },
}
